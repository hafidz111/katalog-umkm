# Salin file ini menjadi .env.local lalu isi nilainya.
# Isi juga variabel yang sama di Vercel: Project > Settings > Environment Variables.
#
# PENTING: semua variabel di bawah hanya dipakai di SERVER.
# JANGAN beri awalan NEXT_PUBLIC_ supaya tidak terkirim ke browser.
#
# Lokasi di dashboard Supabase: Project Settings > API (atau API Keys).
# Jika proyekmu masih memakai key lama, pakai "anon" untuk PUBLISHABLE
# dan "service_role" untuk SECRET.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 9router: hanya dipakai Server Action admin. URL dasar boleh berakhiran /v1.
NINEROUTER_URL=https://router.titiksenyapstudio.id
# Token dari dashboard 9router, bukan Gemini key.
NINEROUTER_TOKEN=
# ID persis dari daftar Models/Combo di dashboard 9router.
NINEROUTER_MODEL=combo

# Bucket publik untuk foto katalog; upload hanya melalui sesi admin di server.
# Buat bucket/policy dengan docs/storage.sql di dashboard Supabase.
SUPABASE_STORAGE_BUCKET=foto-produk
